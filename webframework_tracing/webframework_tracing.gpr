with "config/webframework_tracing_config.gpr";
project Webframework_Tracing is

   for Library_Name use "Webframework_Tracing";
   for Library_Version use
     Project'Library_Name & ".so." & Webframework_Tracing_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Webframework_Tracing_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("WEBFRAMEWORK_TRACING_LIBRARY_TYPE",
               external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        Webframework_Tracing_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Webframework_Tracing;
