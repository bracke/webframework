with "config/webframework_config.gpr";

project Webframework is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Webframework_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";
   for Library_Name use "webframework";
   for Library_Kind use "static";
   for Library_Interface use
     ("Web",
      "Web.Connection",
      "Web.Config",
      "Web.Context",
      "Web.Cookie",
      "Web.Dispatcher",
      "Web.Errors",
      "Web.Events",
      "Web.Guard",
      "Web.Html",
      "Web.Live",
      "Web.Logging",
      "Web.Multipart",
      "Web.Patch",
      "Web.Protocol",
      "Web.Request",
      "Web.Response",
      "Web.Security",
      "Web.Application",
      "Web.Server",
      "Web.Static",
      "Web.TLS",
      "Web.WebSocket",
      "Web.Assets",
      "Web.Assets.Clients",
      "Web.Binding",
      "Web.Binding.Errors",
      "Web.Binding.Paths",
      "Web.Binding.Limits",
      "Web.Binding.Policies",
      "Web.Binding.Results",
      "Web.Binding.Decoders",
      "Web.Binding.Decoders.Integer_Decoders",
      "Web.Binding.Decoders.Boolean_Decoders",
      "Web.Binding.Decoders.Text_Decoders",
      "Web.Binding.Decoders.Enum_Decoders",
      "Web.Binding.Decoders.UUID_Decoders",
      "Web.Binding.Decoders.Optional_Decoders",
      "Web.Binding.Decoders.Defaulted_Decoders",
      "Web.Binding.Decoders.URI_Decoders",
      "Web.Binding.Decoders.Calendar",
      "Web.Binding.Decoders.Date_Decoders",
      "Web.Binding.Decoders.Time_Decoders",
      "Web.Binding.Decoders.DateTime_Decoders",
      "Web.Binding.Decoders.Modular_Decoders",
      "Web.Binding.Decoders.Float_Decoders",
      "Web.Binding.Decoders.Base64_Decoders",
      "Web.Binding.Sources",
      "Web.Binding.Percent",
      "Web.Binding.Query",
      "Web.Binding.Route",
      "Web.Binding.Headers",
      "Web.Binding.Cookies",
      "Web.Binding.Record_Binders",
      "Web.Binding.Union_Binders",
      "Web.Binding.Names",
      "Web.Binding.Streams",
      "Web.Binding.Streams.Memory",
      "Web.Binding.Bodies",
      "Web.Binding.Codecs",
      "Web.Binding.Codecs.URL_Encoded",
      "Web.Binding.Codecs.JSON",
      "Web.Binding.Codecs.JSON.Binding",
      "Web.Binding.Media_Types",
      "Web.Binding.Codecs.Registry",
      "Web.Binding.Multipart",
      "Web.Binding.Multipart.Binding",
      "Web.Binding.Uploads",
      "Web.Binding.Uploads.Memory",
      "Web.Binding.Auth",
      "Web.Binding.Contexts",
      "Web.Binding.Requests",
      "Web.Binding.Decoders.Guard",
      "Web.Binding.Diagnostics",
      "Web.Binding.Diagnostics.Recording");
   package Compiler is
      for Default_Switches ("Ada") use
        Webframework_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnata", "-gnatwe", "-gnatyM120");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   --  Web.TLS binds libssl/libcrypto directly; declare the link so every
   --  executable that links this library (tests, example app, CLI) resolves
   --  the OpenSSL symbols.
   package Linker is
      for Linker_Options use ("-lssl", "-lcrypto");
   end Linker;
end Webframework;
