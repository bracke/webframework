with "webframework.gpr";
with "webframework_navigation.gpr";
with "webframework_forms.gpr";
with "navigation.gpr";
with "forms.gpr";

project Integration_Demo is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("demo.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatX", "-g", "-gnatwe");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Integration_Demo;
