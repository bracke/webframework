with "config/webframework_cli_config.gpr";

project Webframework_Cli is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Webframework_Cli_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("webframework.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Webframework_Cli_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnata", "-gnatwe", "-gnatyM120", "-gnatwU", "-gnatwM");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use ("-lssl", "-lcrypto");
   end Linker;
end Webframework_Cli;
