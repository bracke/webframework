with "forms.gpr";
with "webframework.gpr";

library project Webframework_Forms is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Library_Name use "webframework_forms";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatX", "-g", "-gnatwe", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Webframework_Forms;
