with "project_tools.gpr";

project Bridge_Tools is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("check_bridges.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatX", "-g", "-gnatwe");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Bridge_Tools;
